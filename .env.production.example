# Production environment — copy to .env and fill in real values before deploying.
# NEVER commit .env to Git.

# Required
SECRET_KEY=generate-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Your public URL(s) — required for HTTPS login/forms
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PostgreSQL (required for production — NOT SQLite)
DB_NAME=vachas
DB_USER=vachas
DB_PASSWORD=change-this-strong-password
DB_HOST=db
DB_PORT=5432

# Or use a single connection string (Render/Railway provide this):
# DATABASE_URL=postgres://user:password@host:5432/vachas

# Optional
PORT=8000
GUNICORN_WORKERS=3
RUN_SEED=true
SECURE_SSL_REDIRECT=True
